# =============================================================================
# OmniOps Environment Variables
# Copy this file to .env (and apps/api/.env + apps/web/.env.local as needed)
# =============================================================================

NODE_ENV=development

# Database (PostgreSQL 16)
POSTGRES_USER=omniops
POSTGRES_PASSWORD=omniops_dev_password
POSTGRES_DB=omniops
POSTGRES_PORT=5433
DATABASE_URL="postgresql://omniops:omniops_dev_password@localhost:5433/omniops?schema=public"

# Cache & Queues (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=omniops_redis_dev
REDIS_URL="redis://:omniops_redis_dev@localhost:6379"

# Object Storage (MinIO S3-Compatible for Export Jobs)
MINIO_ROOT_USER=omniops_minio
MINIO_ROOT_PASSWORD=omniops_minio_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_EXPORTS=omniops-exports
MINIO_USE_SSL=false

# API Server & Authentication
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-64-char-random-access-secret-for-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-64-char-random-refresh-secret-for-production
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Export Worker (Playwright & ExcelJS)
EXPORT_WORKER_CONCURRENCY=2
EXPORT_LINK_TTL_HOURS=24
EXPORT_SYNC_ROW_THRESHOLD=5000

# Bulk Actions Safety Limit
BULK_ACTION_MAX_ITEMS=100

# Web App (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEMO_MODE=true
